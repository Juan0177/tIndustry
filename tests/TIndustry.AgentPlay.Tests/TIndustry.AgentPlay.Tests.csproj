    <ProjectReference Include="../../tools/AgentPlay/AgentPlay.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/TIndustry.Shared/TIndustry.Shared.csproj" />
  </ItemGroup>
</Project>
