<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TIndustry.Shared/TIndustry.Shared.csproj" />
  </ItemGroup>

  <!-- Client-only pure code (no Godot types), tested here as linked files: effects must not live in Shared. -->
  <ItemGroup>
    <Compile Include="../../godot/scripts/visuals/effects/EffectDef.cs" Link="Linked/EffectDef.cs" />
    <Compile Include="../../godot/scripts/visuals/effects/EffectRules.cs" Link="Linked/EffectRules.cs" />
    <Compile Include="../../godot/scripts/settings/TolerantEnumConverter.cs" Link="Linked/TolerantEnumConverter.cs" />
  </ItemGroup>

  <!-- Same seed the Godot client ships. -->
  <ItemGroup>
    <None Include="../../data/content.json" Link="data/content.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/campaign.json" Link="data/campaign.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/maps/*" Link="data/maps/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/png/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../godot/assets/*.png" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
