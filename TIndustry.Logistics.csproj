<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="data\content.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\game-data.xlsx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('data\game-data.xlsx')" />
    <None Include="assets\fonts\**\*" CopyToOutputDirectory="PreserveNewest" Link="assets\fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
</Project>