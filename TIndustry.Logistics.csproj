<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.4</Version>
    <AssemblyVersion>0.2.4.0</AssemblyVersion>
    <FileVersion>0.2.4.0</FileVersion>
    <InformationalVersion>0.2.4</InformationalVersion>
    <Product>tIndustry</Product>
    <AssemblyTitle>tIndustry</AssemblyTitle>
    <!-- Sources live under src/{App,Simulation,Content,UI}; SDK globs **/*.cs from the project dir. -->
    <RootNamespace>TIndustry.Logistics</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Seed templates only — runtime copies into AppData on first launch. Do not ship Excel. -->
    <None Include="data\content.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\campaign.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\fonts\**\*" CopyToOutputDirectory="PreserveNewest" Link="assets\fonts\%(Filename)%(Extension)" />
    <None Include="assets\icons\**\*" CopyToOutputDirectory="PreserveNewest" Link="assets\icons\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="assets\thumbnail.png" CopyToOutputDirectory="PreserveNewest" Link="assets\thumbnail.png" />
    <None Include="assets\ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" Link="assets\ATTRIBUTION.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
</Project>
