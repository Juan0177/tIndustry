<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Product>tIndustry</Product>
    <AssemblyTitle>tIndustry</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <None Include="data\content.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\game-data.xlsx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('data\game-data.xlsx')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
</Project>
