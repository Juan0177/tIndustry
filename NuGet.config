<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: a machine-level local source (e.g. left by a newer Godot install) must not leak in
       and resolve GodotSharp to a version different from the Godot 4.4.1 runtime (#292). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
